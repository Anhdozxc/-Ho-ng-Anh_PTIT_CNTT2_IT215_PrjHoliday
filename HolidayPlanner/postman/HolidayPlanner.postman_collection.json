          "request":{"auth":{"type":"basic","basic":[{"key":"username","value":"{{postmanEmail}}","type":"string"},{"key":"password","value":"{{postmanPassword}}","type":"string"}]},"method":"GET","url":"{{baseUrl}}/api/profile"}
