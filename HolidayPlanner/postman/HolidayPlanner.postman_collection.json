          "request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"{{postmanDestinationName}}\",\n  \"city\": \"Hạ Long\",\n  \"country\": \"Việt Nam\",\n  \"description\": \"Đã cập nhật\",\n  \"imageUrl\": \"/images/destination-fallback.svg\",\n  \"active\": true\n}"},"url":"{{baseUrl}}/api/admin/destinations/{{adminDestinationId}}"}
