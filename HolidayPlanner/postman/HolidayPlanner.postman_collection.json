          "request":{"auth":{"type":"basic","basic":[{"key":"username","value":"{{userEmail}}","type":"string"},{"key":"password","value":"{{userPassword}}","type":"string"}]},"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Postman Demo Trip Updated\",\n  \"destinationId\": {{destinationId}},\n  \"startDate\": \"{{tripStartDate}}\",\n  \"endDate\": \"{{tripEndDate}}\",\n  \"peopleCount\": 3,\n  \"budget\": 12000000,\n  \"status\": \"COMPLETED\"\n}"},"url":"{{baseUrl}}/api/trips/{{tripId}}"}
