          "request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"status\": \"LOCKED\"\n}"},"url":"{{baseUrl}}/api/admin/users/{{userId}}/status"}
        },
